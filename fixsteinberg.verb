w_metadata fixsteinberg dlls \
    title="Fixes for running Steinberg's Dorico, WaveLab and Cubase under Wine" \
    publisher="chiarfe" \
    year="2026"

ROOT_URL="https://raw.githubusercontent.com/chiarfe/steinberg_fix/refs/heads/main"

for _fix_verb in dcomp pwrshsip
do
    winetricks_metadata_exists "${_fix_verb}" && continue
    w_download_to "${W_CACHE}/steinberg_fix" "${ROOT_URL}/${_fix_verb}/${_fix_verb}.verb"
    source "${W_CACHE}/steinberg_fix/${_fix_verb}.verb"
done
unset _fix_verb

load_fixsteinberg()
{
    w_set_unattended 1

    # Install fonts packages
    w_call corefonts
    w_call fontsmooth=rgb

    # Replace "Segoe UI" with a more similar font than default "Arial"
    w_try reg add "HKCU\\Software\\Wine\\Fonts\\Replacements" \
        /v "Segoe UI" /t REG_MULTI_SZ /d "Noto Sans\0DejaVu Sans\0Liberation Sans" /f

    # Install common required packages
    w_call vcrun2022
    w_call dotnet48
    w_call dxvk
    w_call vkd3d
    w_call win11

    # Install custom fixes
    w_call dcomp
    w_call pwrshsip
}
