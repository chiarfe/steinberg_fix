w_metadata fixdorico dlls \
    title="Fixes for running Steinberg's Dorico under Wine" \
    publisher="chiarfe" \
    year="2026"

ROOT_URL="https://raw.githubusercontent.com/chiarfe/steinberg_fix/refs/heads/main"

for _fix_verb in dcomp pwrshsip
do
    winetricks_metadata_exists "${_fix_verb}" && continue
    w_download_to "${W_CACHE}/steinberg_fix" "${ROOT_URL}/${_fix_verb}/${_fix_verb}.verb"
    source "${W_CACHE}/steinberg_fix/${_fix_verb}.verb"
done
unset _fix_verb

load_fixdorico()
{
    w_set_unattended 1
    w_call corefonts
    w_call fontsmooth=rgb
    w_call vcrun2022
    w_call dotnet48
    w_call win11

    w_call dcomp
    w_call pwrshsip
}
