w_metadata fixwavelab dlls \
    title="Fixes for running Steinberg's WaveLab under Wine" \
    publisher="chiarfe" \
    year="2026"

load_fixwavelab()
{
    # Existing winetricks
    w_set_unattended 1
    w_call corefonts
    w_call fontsmooth=rgb
    w_call vcrun2022
    w_call dotnet48
    w_call win11
}
